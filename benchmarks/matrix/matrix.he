var N = 150;

var A = [];
var B = [];
var C = [];

for (var i = 0; i < N; i++) {
    A.push([]);
    B.push([]);
    C.push([]);

    for (var j = 0; j < N; j++) {
        A[i].push((i + j) % 100);
        B[i].push((i * j) % 100);
        C[i].push(0);
    }
}

for (var i = 0; i < N; i++) {
    for (var j = 0; j < N; j++) {
        var sum = 0;

        for (var k = 0; k < N; k++) {
            sum += A[i][k] * B[k][j];
        }

        C[i][j] = sum;
    }
}

print C[0][0];
print C[N - 1][N - 1];