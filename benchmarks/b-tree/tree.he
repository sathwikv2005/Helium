class Node {
    init(value) {
        this.value = value;
        this.left = null;
        this.right = null;
    }

    insert(value) {
        if (value < this.value) {
            if (this.left == null) {
                this.left = Node(value);
            } else {
                this.left.insert(value);
            }
        } else {
            if (this.right == null) {
                this.right = Node(value);
            } else {
                this.right.insert(value);
            }
        }
    }

    sum() {
        var total = this.value;

        if (this.left != null) {
            total = total + this.left.sum();
        }

        if (this.right != null) {
            total = total + this.right.sum();
        }

        return total;
    }
}

const N = 100000;

var root = Node(50000);

var i = 0;
while (i < N) {
    root.insert((i * 7919) % N);
    i = i + 1;
}
