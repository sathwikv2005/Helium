var n = 1000000;
var prime = [];

for (var i = 0; i <= n; i++) {
    prime.push(true);
}

prime[0] = false;
prime[1] = false;

for (var i = 2; i * i <= n; i++) {
    if (prime[i]) {
        for (var j = i * i; j <= n; j += i) {
            prime[j] = false;
        }
    }
}

var count = 0;

for (var i = 0; i <= n; i++) {
    if (prime[i]) count++;
}

print count;