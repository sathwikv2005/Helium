class Node {
    init(value, next) {
        this.value = value;
        this.next = next;
    }

    sum() {
        var total = 0;
        var current = this;

        while (current != null) {
            total = total + current.value;
            current = current.next;
        }

        return total;
    }
}

const N = 1000000;

var head = null;

var i = 0;
while (i < N) {
    head = Node(i, head);
    i = i + 1;
}
