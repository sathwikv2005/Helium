var i = 0;
while (i < 5) {
    if (i == 2) break;
    print i;
    i = i + 1;
}
var i = 0;
while (i < 2) {
    var j = 0;
    while (j < 3) {
        if (j == 1) break;
        print j;
        j = j + 1;
    }
    i = i + 1;
}

for (var i = 0; i < 5; i = i + 1) {
    if (i == 3) break;
    print i;
}