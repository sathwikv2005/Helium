var i = 0;
while (i < 3) {
    i = i + 1;
    continue;
    print 999;
}
for (var i = 0; i < 5; i = i + 1) {
    if (i == 2) continue;
    print i;
}
var i = 0;
while (i < 5) {
    i = i + 1;
    if (i == 3) continue;
    print i;
}
var i = 0;
while (i < 2) {
    var j = 0;
    while (j < 3) {
        j = j + 1;
        if (j == 2) continue;
        print j;
    }
    i = i + 1;
}